# Copy this file to apps/api/.env and fill in your Supabase values.

# Supabase > Connect > ORMs > Prisma
# Pooled connection (port 6543) used by the running API
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by `prisma db push`
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Any long random string, used to sign login tokens
JWT_SECRET="change-me-to-a-long-random-string"

# Supabase > Project Settings > Data API (base URL only, no /rest/v1)
SUPABASE_URL="https://xxxx.supabase.co"
# Supabase > Project Settings > API Keys > service_role (server only, never expose to the web app)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# URL of the web app, allowed by CORS (comma-separate multiple origins)
WEB_ORIGIN="http://localhost:3000"
PORT=4000
